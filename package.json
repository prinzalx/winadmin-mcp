{
  "name": "winadmin-mcp",
  "version": "0.5.1",
  "description": "Windows administration MCP server with a web interface to switch tools on and off",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "winadmin-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-webui.mjs",
    "dev": "npm run build && node --watch dist/index.js",
    "test": "node scripts/mcp-smoke.mjs && node scripts/mcp-popup-check.mjs && node scripts/mcp-http-popup-check.mjs",
    "start": "node dist/index.js",
    "web": "node dist/index.js",
    "web:check": "node scripts/web-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
